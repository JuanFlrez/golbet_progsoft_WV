@{

    ViewData["Title"] = "Inicio";

}

  

<div class="text-center py-5">

    <h1 class="display-4">⚽ Bienvenido a GolBet</h1>

    <p class="lead">

        El simulador de apuestas de fútbol donde arriesgas FutCoins, no dinero.

    </p>

    <form asp-controller="Matches" asp-action="Index" method="get"
          class="row g-2 justify-content-center mb-4" role="search">
        <div class="col-sm-8 col-md-5">
            <label class="visually-hidden" for="teamName">Buscar equipo</label>
            <input id="teamName" name="teamName" class="form-control"
                   type="search" placeholder="Buscar equipo..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-success">Buscar</button>
        </div>
    </form>
    <a class="btn btn-success btn-lg" asp-controller="Matches" asp-action="Index">

        Ver partidos

    </a>

</div> 
